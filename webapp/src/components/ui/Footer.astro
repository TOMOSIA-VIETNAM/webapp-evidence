---
import LangSwitcher from './LangSwitcher.astro'
import { localeFromUrl, useTranslations } from '../../i18n'
import { REPO_URL, RELEASES_URL, ISSUES_URL, LICENSE_URL, TOMOSIA_URL, TOMOSIA_NAME } from '../../lib/site'

const t = useTranslations(localeFromUrl(Astro.url))

const links = [
  { href: REPO_URL, label: t('nav.github') },
  { href: RELEASES_URL, label: t('footer.releases') },
  { href: ISSUES_URL, label: t('footer.issues') },
  { href: LICENSE_URL, label: t('footer.license') },
]
---

<footer class="border-t border-hairline bg-surface-sunken">
  <div class="mx-auto flex w-full max-w-page flex-col gap-6 px-5 pt-10 pb-28 sm:px-8 sm:pb-12">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-10 items-center text-sm text-ink-muted no-underline transition-colors duration-[var(--duration-fast)] ease-ios hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <LangSwitcher align="end" />
    </div>

    {/* The organisation behind the project, as attribution rather than a second brand. */}
    <div class="flex flex-wrap items-center gap-2 border-t border-hairline pt-6 text-sm text-ink-muted sm:pr-28">
      <span>{t('footer.by')}</span>
      <a
        href={TOMOSIA_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-10 items-center font-semibold text-ink no-underline transition-colors duration-[var(--duration-fast)] ease-ios hover:text-accent"
      >
        {TOMOSIA_NAME}
      </a>
      <span aria-hidden="true">·</span>
      <span>{t('footer.licenseLine')}</span>
    </div>
  </div>
</footer>
