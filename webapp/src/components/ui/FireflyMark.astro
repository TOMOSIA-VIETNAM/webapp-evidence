---
/**
 * The webapp-evidence firefly, inline so its parts can move. The geometry is docs/images/logo/logo.svg,
 * split into wings, body and lantern by scripts/sync-upstream.mjs — never redrawn here.
 *
 * `recording` makes the lantern pulse like a record light. `flapOnHover` beats the wings while the
 * pointer is over it. A parent adds `data-firefly-takeoff` to make it beat hard and fly up, and the
 * class `firefly--greet` beats the wings three times, which is how the hero answers it.
 */
import firefly from '../../assets/upstream/firefly.json'

interface Props extends Record<string, unknown> {
  class?: string
  recording?: boolean
  flapOnHover?: boolean
  title?: string
}

const { class: className = '', recording = false, flapOnHover = false, title, ...rest } = Astro.props
const { viewBox, parts } = firefly
---

<svg
  viewBox={viewBox}
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  class:list={['firefly', recording && 'firefly--recording', flapOnHover && 'firefly--flap-on-hover', className]}
  {...rest}
>
  <g class="firefly__light" data-loop>
    {parts.light.map((p) => <polygon points={p.points} fill={p.fill} />)}
  </g>
  <g class="firefly__wing firefly__wing--left">
    {parts.left.map((p) => <polygon points={p.points} fill={p.fill} />)}
  </g>
  <g class="firefly__wing firefly__wing--right">
    {parts.right.map((p) => <polygon points={p.points} fill={p.fill} />)}
  </g>
  <g class="firefly__body">
    {parts.body.map((p) => <polygon points={p.points} fill={p.fill} />)}
  </g>
</svg>

<style>
  .firefly {
    overflow: visible;
  }

  /* Wings pivot where they meet the body, which is the only way a flap reads as a flap. */
  .firefly__wing {
    transform-box: view-box;
    transform-origin: 64px 44px;
  }

  .firefly__light {
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes firefly-flap {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.62);
    }
  }

  /* The lantern is a record dot: it brightens and swells on a slow, steady clock. Only opacity and
     scale move — the compositor runs those — while its glow stays put; an animated filter was
     repainted on every frame, on a phone for as long as the page was open. */
  @keyframes firefly-record {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.94);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  @keyframes firefly-takeoff {
    0% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
    35% {
      transform: translateY(6%) scale(0.96);
      opacity: 1;
    }
    100% {
      transform: translateY(-180%) scale(0.7);
      opacity: 0;
    }
  }

  .firefly--recording .firefly__light {
    filter: drop-shadow(0 0 0.4rem var(--color-accent-glow));
    animation: firefly-record 2.4s cubic-bezier(0.37, 0, 0.63, 1) infinite;
  }

  .firefly--flap-on-hover:hover .firefly__wing,
  .firefly--recording:hover .firefly__wing {
    animation: firefly-flap 0.5s var(--ease-ios) infinite;
  }

  /* Parts inside an SVG animate on the main thread in every browser, whatever the property. On a
     touch device the lantern holds its light rather than repaint for as long as the page is open;
     the REC dot beside the headline, an ordinary element, still blinks. */
  @media (hover: none), (pointer: coarse) {
    .firefly--recording .firefly__light {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .firefly,
    .firefly__wing,
    .firefly__light {
      animation: none !important;
    }
  }
</style>

<!-- Hover and takeoff are driven by a parent element, which scoped styles cannot reach. -->
<style is:global>
  [data-firefly-hover]:hover .firefly__wing {
    animation: firefly-flap 0.5s var(--ease-ios) infinite;
  }

  [data-firefly-takeoff] .firefly .firefly__wing {
    animation: firefly-flap 0.16s linear 4;
  }

  [data-firefly-takeoff] .firefly {
    animation: firefly-takeoff 0.62s var(--ease-ios) forwards;
  }

  /* The mark in the hero answers the one that just flew back up. */
  .firefly--greet .firefly__wing {
    animation: firefly-flap 0.36s var(--ease-ios) 3;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-firefly-hover]:hover .firefly__wing,
    [data-firefly-takeoff] .firefly,
    [data-firefly-takeoff] .firefly .firefly__wing,
    .firefly--greet .firefly__wing {
      animation: none !important;
    }
  }
</style>
