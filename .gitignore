# Runner dependency, installed with: npm install --prefix src/skills/recording/scripts
src/skills/recording/scripts/node_modules/

.DS_Store

# Repositories that live inside this one: another session's git worktrees, and whatever is
# checked out under notebooks/. Without these, one `git add -A` commits a nested repository as
# a gitlink and the clone that follows has an empty directory where it was.
.claude/worktrees/
notebooks/
